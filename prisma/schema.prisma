generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EmployeeType {
  TETAP
  KONTRAK
  MAGANG
  KONTRAKTOR
}

enum EmployeeStatus {
  AKTIF
  CUTI
  ONBOARDING
  OFFBOARDING
}

enum PayrollCycleStatus {
  DRAFT
  REVIEW_VARIANSI
  MENUNJU_PERSETUJUAN
  TERKUNCI
  DIBAYAR
}

enum LeaveRequestStatus {
  MENUNJU
  DISETUJUI
  DITOLAK
}

enum TicketStatus {
  TERBUKA
  DALAM_PROSES
  SELESAI
}

enum TicketPriority {
  TINGGI
  SEDANG
  RENDAH
}

enum IntegrationStatus {
  TERHUBUNG
  UJI_COBA
  TERPUTUS
}

enum WorkflowStepStatus {
  SELESAI
  MENUNJU
  BELUM
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("KARYAWAN")
  entity        String?
  country       String?
  department    String?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Entity {
  id          String   @id @default(cuid())
  name        String
  country     String
  currency    String   @default("IDR")
  headcount   Int      @default(0)
  payrollMode String   @default("IN_HOUSE")
  status      String   @default("AKTIF")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departments   Department[]
  costCenters   CostCenter[]
  payrollCycles PayrollCycle[]
}

model Department {
  id          String   @id @default(cuid())
  name        String
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  headcount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions   Position[]
  costCenters CostCenter[]
}

model CostCenter {
  id          String   @id @default(cuid())
  code        String
  name        String
  entityId    String
  entity      Entity   @relation(fields: [entityId], references: [id])
  departmentId String?
  department  Department? @relation(fields: [departmentId], references: [id])
  owner       String?
  budgetPct   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Position {
  id          String   @id @default(cuid())
  title       String
  grade       String
  departmentId String
  department  Department @relation(fields: [departmentId], references: [id])
  entityId    String
  isActive    Boolean  @default(true)
  headcount   Int      @default(0)
  vacant      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id             String   @id @default(cuid())
  nik            String?   @unique
  npwp           String?
  bpjs           String?
  name           String
  email          String
  phone          String?
  role           String
  department     String
  entity         String
  country        String
  location       String
  type           EmployeeType @default(TETAP)
  status         EmployeeStatus @default(AKTIF) @map("status")
  joinDate       DateTime
  lastDay        DateTime?
  manager        String?
  grade          String?
  salary         Int?
  currency       String?   @default("IDR")
  bank           String?
  account        String?
  accountVerified Boolean @default(false)
  taxStatus      String?   @default("TK/0")
  photoUrl       String?
  tone           String?   @default("mint")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employmentHistory EmploymentHistory[]
  leaveRequests     LeaveRequest[]
  leaveBalances     LeaveBalance[]
  attendanceRecords AttendanceRecord[]
  overtimeRequests  OvertimeRequest[]
  expenseClaims     Expense[]
  tickets           Ticket[]
  payslips          Payslip[]
}

model EmploymentHistory {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  effective   DateTime
  inputDate   DateTime @default(now())
  title       String
  detail      String?
  reason      String?
  actor       String?
  grade       String?
  salary      Int?
  entity      String?
  department  String?
  position    String?
  type        EmployeeType?
  status      EmployeeStatus?
  createdAt   DateTime @default(now())

  @@index([employeeId, effective])
}

model PayrollCycle {
  id          String              @id @default(cuid())
  period      String
  entityId    String
  entity      Entity              @relation(fields: [entityId], references: [id])
  country     String
  employees   Int
  gross       Int                 @default(0)
  net         Int                 @default(0)
  tax         Int                 @default(0)
  social      Int                 @default(0)
  currency    String              @default("IDR")
  status      PayrollCycleStatus  @default(DRAFT)
  progress    Int                 @default(0)
  anomalies   Int                 @default(0)
  variance    Float               @default(0)
  cutoff      DateTime?
  payDate     DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  components   PayrollComponent[]
  results      PayrollResult[]
  payslips     Payslip[]
  varianceLogs PayrollVariance[]
  anomalyRecords PayrollAnomaly[]
  glJournal    GLJournalEntry[]
  approvalSteps PayrollApprovalStep[]

  @@index([entityId, period])
}

model PayrollComponent {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       PayrollCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  label       String
  amount      Int
  type        String   // "Penghasilan" | "Potongan"
  createdAt   DateTime @default(now())
}

model PayrollResult {
  id          String   @id @default(cuid())
  cycleId     String
  cycle       PayrollCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employeeId  String
  gross       Int
  deduction   Int
  net         Int
  tax         Int
  social      Int
  currency    String   @default("IDR")
  status      String   @default("DRAFT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([cycleId, employeeId])
}

model Payslip {
  id          String   @id @default(cuid())
  cycleId     String?
  cycle       PayrollCycle? @relation(fields: [cycleId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  period      String
  gross       Int
  deduction   Int
  net         Int
  status      String   @default("DRAFT")
  downloadedAt DateTime?
  downloadedBy String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, period])
}

model PayrollVariance {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     PayrollCycle @relation(fields: [cycleId], references: [id])
  employeeId String
  component String
  prev      Int
  next      Int
  delta     Float
  reason    String?
  createdAt DateTime @default(now())
}

model PayrollAnomaly {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     PayrollCycle @relation(fields: [cycleId], references: [id])
  severity  String
  title     String
  detail    String?
  owner     String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

model GLJournalEntry {
  id         String   @id @default(cuid())
  cycleId    String
  cycle      PayrollCycle @relation(fields: [cycleId], references: [id])
  account    String
  costCenter String
  debit      Int      @default(0)
  credit     Int      @default(0)
  createdAt  DateTime @default(now())
}

model PayrollApprovalStep {
  id        String   @id @default(cuid())
  cycleId   String
  cycle     PayrollCycle @relation(fields: [cycleId], references: [id])
  role      String
  name      String
  status    WorkflowStepStatus @default(BELUM)
  at        String?
  createdAt DateTime @default(now())
}

model LeaveType {
  id          String   @id @default(cuid())
  name        String
  entityId    String
  annualDays  Int      @default(0)
  rules       String?  // JSON config
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leaveRequests LeaveRequest[]
  leaveBalances LeaveBalance[]
}

model LeaveRequest {
  id          String              @id @default(cuid())
  employeeId  String
  employee    Employee            @relation(fields: [employeeId], references: [id])
  typeId      String
  type        LeaveType           @relation(fields: [typeId], references: [id])
  startDate   DateTime
  endDate     DateTime
  days        Int
  status      LeaveRequestStatus  @default(MENUNJU)
  approverId  String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, status])
}

model LeaveBalance {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  typeId      String
  type        LeaveType @relation(fields: [typeId], references: [id])
  used        Int      @default(0)
  total       Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([employeeId, typeId])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  clockIn     String?
  clockOut    String?
  location    String?
  status      String   @default("ABSEN")
  hours       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId, date])
}

model Shift {
  id          String   @id @default(cuid())
  name        String
  startTime   String
  endTime     String
  entityId    String
  headcount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model OvertimeRequest {
  id        String   @id @default(cuid())
  employeeId String
  employee  Employee @relation(fields: [employeeId], references: [id])
  date      DateTime
  hours     Float
  reason    String?
  status    String   @default("MENUNJU")
  createdAt DateTime @default(now())
}

model OnboardingTask {
  id        String   @id @default(cuid())
  label     String
  owner     String
  done      Boolean  @default(false)
  employeeId String?
  dueDate   DateTime?
  createdAt DateTime @default(now())
}

model OffboardingTask {
  id        String   @id @default(cuid())
  label     String
  owner     String
  done      Boolean  @default(false)
  employeeId String?
  dueDate   DateTime?
  clearance String?
  finalPay  String?
  createdAt DateTime @default(now())
}

model Requisition {
  id        String   @id @default(cuid())
  role      String
  dept      String
  entity    String
  headcount Int
  stage     String
  days      Int
  budget    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]
}

model Candidate {
  id        String   @id @default(cuid())
  name      String
  role      String
  score     Int
  source    String
  stageId   String
  stage     Requisition @relation(fields: [stageId], references: [id])
  createdAt DateTime @default(now())
}

model Interview {
  id        String   @id @default(cuid())
  time      String
  name      String
  role      String
  panel     String
  mode      String
  date      DateTime
  createdAt DateTime @default(now())
}

model PerformanceReview {
  id        String   @id @default(cuid())
  employeeId String
  cycle     String
  score     Float?
  status    String   @default("DRAFT")
  reviewerId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OKR {
  id          String   @id @default(cuid())
  title       String
  owner       String
  progress    Int      @default(0)
  keyResults  String?
  tone        String?  @default("lime")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SalaryBand {
  id        String   @id @default(cuid())
  grade     String
  title     String
  min       Int
  mid       Int
  max       Int
  headcount Int      @default(0)
  compa     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Benefit {
  id        String   @id @default(cuid())
  name      String
  provider  String
  coverage  String
  enrolled  Int      @default(0)
  eligible  Int      @default(0)
  tone      String?  @default("mint")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Expense {
  id        String   @id @default(cuid())
  employeeId String
  employee  Employee @relation(fields: [employeeId], references: [id])
  category  String
  amount    Int
  date      DateTime
  status    String   @default("MENUNJU")
  ocr       Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Ticket {
  id        String   @id @default(cuid())
  employeeId String?
  employee  Employee? @relation(fields: [employeeId], references: [id])
  subject   String
  category  String
  priority  TicketPriority @default(SEDANG)
  status    TicketStatus @default(TERBUKA)
  assignee  String?
  sla       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  target    String?
  field     String?
  before    String?
  after     String?
  reason    String?
  ipAddress String?
  userAgent String?

  @@index([at])
  @@index([actorId])
  @@index([action])
}

model Integration {
  id        String   @id @default(cuid())
  name      String
  vendor    String
  status    IntegrationStatus @default(TERHUBUNG)
  detail    String?
  tone      String?  @default("lime")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowConfig {
  id        String   @id @default(cuid())
  name      String
  entityId  String?
  version   Int      @default(1)
  conditions String?
  sla       String?
  escalation String?
  environment String @default("sandbox")
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
